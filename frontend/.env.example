# =====================================================================
# Frontend environment variables (Vite)
# =====================================================================
# Local: copy to .env and use http://localhost:8000 values.
# Deployment (Vercel): paste each var into Project Settings > Environment Variables.
# All VITE_* vars are bundled into the client build - do NOT put secrets here.
# =====================================================================


# --- Backend API URL ---
# Local:      http://localhost:8000/api
# Production: https://your-backend.onrender.com/api
VITE_API_BASE_URL=https://your-backend.onrender.com/api


# --- Backend WebSocket URL ---
# Used for real-time notifications and WebRTC livestream signaling.
# Must use ws:// for http backend, wss:// for https backend (no /api suffix).
# Local:      ws://localhost:8000
# Production: wss://your-backend.onrender.com
VITE_WS_BASE_URL=wss://your-backend.onrender.com


# --- Demo webcam API key ---
# Must match a valid camera api_key in the backend (or the global WEBHOOK_API_KEY).
# Used by the in-browser webcam demo only.
VITE_DEMO_WEBCAM_KEY=demo-webcam-api-key-for-testing-1234567890abcdef0123456789abcdef


# --- Firebase config (optional, for push notifications) ---
# Get these from Firebase Console > Project Settings > General > Your apps.
# Leave blank to disable push notifications.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase VAPID key — Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=
