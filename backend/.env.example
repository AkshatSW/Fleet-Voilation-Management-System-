# =====================================================================
# Backend environment variables
# =====================================================================
# Local: copy to .env and adjust for your local Postgres.
# Deployment (Render/Railway/Fly.io): paste each var into the host's
# dashboard. Do NOT commit real secrets.
# =====================================================================


# --- Database (PostgreSQL ONLY — SQLite is not supported) ---
# Local:      postgresql://postgres:postgres@localhost:5432/fleet_violations
# Production: paste your Neon/Supabase/Render Postgres connection string.
# Format:     postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>


# --- Security (REQUIRED in production — generate strong values) ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-strong-random-string
WEBHOOK_API_KEY=replace-with-strong-random-string


# --- JWT token expiration (minutes) ---
ACCESS_TOKEN_EXPIRE_MINUTES=120


# --- CORS ---
# Comma-separated list of allowed frontend origins. NO trailing slash. NO wildcard.
# Local:      http://localhost:5173
# Production: https://your-frontend.vercel.app
CORS_ORIGINS=https://your-frontend.vercel.app


# --- Uploads directory ---
# Local:                 ./uploads
# Vercel/Lambda:         /tmp/uploads   (ephemeral - resets on restart)
# Render/Railway/VPS:    /tmp/uploads or a persistent disk path
# For production with persistent storage, integrate S3/R2/Azure Blob and update routers/uploads.py.
UPLOADS_DIR=/tmp/uploads


# --- Public URLs ---
# Backend's own public URL (used by webhook callbacks, simulators).
BACKEND_BASE_URL=https://your-backend.onrender.com
# Default camera simulator target (only matters when running simulate_camera.py)
SIMULATE_CAMERA_URL=https://your-backend.onrender.com/api/webhook/violation


# --- Optional: Firebase Cloud Messaging for push notifications ---
# Path to FCM service account JSON file. Leave blank to disable push notifications.
FCM_SERVICE_ACCOUNT_PATH=
