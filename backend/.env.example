# Backend environment variables
# Copy to .env for local dev, or paste into your hosting provider's dashboard.
# Do NOT commit real secrets.


# --- Database (PostgreSQL ONLY) ---
# Required. SQLite is not supported.
# For local: spin up Postgres (Docker, Neon free tier, Supabase, etc.)
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleet_violations


# --- Security ---
# Generate strong values for production: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-in-production
WEBHOOK_API_KEY=change-me-in-production


# --- JWT token expiration (minutes) ---
ACCESS_TOKEN_EXPIRE_MINUTES=120


# --- CORS ---
# Comma-separated list of allowed frontend origins. NO trailing slash.
# Local dev:  http://localhost:5173
# Production: https://your-frontend.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:5173


# --- Uploads directory ---
# Local dev: ./uploads
# Serverless (Vercel/Lambda/etc.): /tmp/uploads (ephemeral!)
# For production with persistent storage, integrate S3/Azure Blob and update routers/uploads.py.
UPLOADS_DIR=./uploads


# --- Public URLs (used by simulators / webhook callbacks) ---
BACKEND_BASE_URL=http://localhost:8000
SIMULATE_CAMERA_URL=http://localhost:8000/api/webhook/violation


# --- Optional: Firebase Cloud Messaging for push notifications ---
# Path to FCM service account JSON file. Leave blank to disable push notifications.
FCM_SERVICE_ACCOUNT_PATH=
