#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT_DIR/frontend"

usage() {
  cat <<EOF
Usage: frontend_run [--port PORT]

Starts the frontend dev server using `npm run dev`. Defaults to port 5176.

Options:
  --port PORT    Port to run the dev server on (default: 5176)
  --help         Show this help
EOF
}

PORT=5176
PORT_SET_EXPLICITLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --port)
      if [ $# -lt 2 ]; then
        echo "Missing value for --port" >&2
        exit 1
      fi
      PORT="$2"
      PORT_SET_EXPLICITLY=1
      shift 2;;
    --help)
      usage; exit 0;;
    *) shift;;
  esac
done

if ! [[ "$PORT" =~ ^[0-9]+$ ]] || [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
  echo "Invalid port: $PORT (must be 1-65535)" >&2
  exit 1
fi

port_in_use() {
  local port="$1"
  if command -v lsof >/dev/null 2>&1; then
    lsof -iTCP:"$port" -sTCP:LISTEN -n -P >/dev/null 2>&1
    return $?
  fi
  if command -v nc >/dev/null 2>&1; then
    nc -z 127.0.0.1 "$port" >/dev/null 2>&1
    return $?
  fi
  (echo >"/dev/tcp/127.0.0.1/$port") >/dev/null 2>&1
}

if [ ! -d node_modules ]; then
  echo "node_modules not found; running 'npm ci' (this may take a while)."
  npm ci
fi

if port_in_use "$PORT"; then
  if [ "$PORT_SET_EXPLICITLY" -eq 1 ]; then
    echo "Port $PORT is already in use." >&2
    if command -v lsof >/dev/null 2>&1; then
      lsof -iTCP:"$PORT" -sTCP:LISTEN -n -P || true
    fi
    echo "Use a different port, e.g. ./frontend_run --port $((PORT + 1))" >&2
    exit 1
  fi

  ORIGINAL_PORT="$PORT"
  while port_in_use "$PORT"; do
    PORT=$((PORT + 1))
    if [ "$PORT" -gt 65535 ]; then
      echo "No free TCP ports available." >&2
      exit 1
    fi
  done
  echo "Port $ORIGINAL_PORT is in use; switching to port $PORT."
fi

echo "Starting frontend dev server on port $PORT"
export PORT
exec npm run dev -- --port "$PORT"
